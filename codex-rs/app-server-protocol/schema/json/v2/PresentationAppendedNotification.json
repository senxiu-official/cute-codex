{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ExternalInputSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ExternalInputSourceKind"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "ExternalInputSourceKind": {
      "enum": [
        "agent",
        "service"
      ],
      "type": "string"
    },
    "Presentation": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "default": "",
          "type": "string"
        },
        "format": {
          "$ref": "#/definitions/PresentationFormat"
        },
        "id": {
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/definitions/PresentationReference"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/definitions/ExternalInputSource"
        },
        "title": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "format",
        "id",
        "references",
        "source"
      ],
      "type": "object"
    },
    "PresentationAppended": {
      "additionalProperties": false,
      "properties": {
        "originThreadId": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "presentation": {
          "$ref": "#/definitions/Presentation"
        },
        "receiptId": {
          "type": "string"
        },
        "semanticSha256": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "originThreadId",
        "ownerId",
        "presentation",
        "receiptId",
        "semanticSha256",
        "version"
      ],
      "type": "object"
    },
    "PresentationFormat": {
      "enum": [
        "plainText",
        "markdown"
      ],
      "type": "string"
    },
    "PresentationReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/PresentationReferenceKind"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "PresentationReferenceKind": {
      "enum": [
        "externalInput",
        "mcpInvocation"
      ],
      "type": "string"
    }
  },
  "properties": {
    "item": {
      "$ref": "#/definitions/PresentationAppended"
    },
    "position": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "item",
    "position",
    "threadId"
  ],
  "title": "PresentationAppendedNotification",
  "type": "object"
}