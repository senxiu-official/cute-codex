{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ToolGateHeldCall": {
      "additionalProperties": false,
      "properties": {
        "callId": {
          "type": "string"
        },
        "sinceMs": {
          "format": "int64",
          "type": "integer"
        },
        "threadId": {
          "description": "The thread the call belongs to: the bound thread or one of its sub-agent threads (they wait on the root's gate).",
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "callId",
        "sinceMs",
        "threadId",
        "tool",
        "turnId"
      ],
      "type": "object"
    }
  },
  "description": "Sent whenever the gate or its waiting calls change.",
  "properties": {
    "held": {
      "type": "boolean"
    },
    "threadId": {
      "type": "string"
    },
    "waiting": {
      "items": {
        "$ref": "#/definitions/ToolGateHeldCall"
      },
      "type": "array"
    }
  },
  "required": [
    "held",
    "threadId",
    "waiting"
  ],
  "title": "ToolGateChangedNotification",
  "type": "object"
}